{
  "manifest_version": 3,
  "name": "mktbox: free marketing tools",
  "short_name": "mktbox",
  "version": "1.0.0",
  "description": "QR codes, UTM links, link previews and speed audits for the page you're on. Free, no account, nothing to upgrade.",
  "homepage_url": "https://mktbox.xyz",
  "action": {
    "default_popup": "popup.html",
    "default_title": "mktbox",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus"]
}
